# Local state from the omo agent tool (run-continuation cache); not project source.
.omo/

# Wrangler local state (caches the Cloudflare account id/email); not project source.
.wrangler/

# Local state from the pi agent harness (goal/task snapshots); not project source.
/.pi/

packaging/.cache/
/fyolo.app/
sandbox-helper/.build/

# Build artifacts inside vendored packages

# Vercel project link (local credentials/metadata)
.vercel/

# xcodebuild derived data for the iOS dev-run script
ios/build/
ios/build-sim/

# Per-project fyolo session state
/.fyolo/

# Python bytecode caches left by the repo's own scripts (download stats, icon
# generation, the fyolod smoke tests and bench).
__pycache__/

# LaTeX build intermediates (talk decks under docs/talks/)
*.aux
*.nav
*.snm
*.toc
*.vrb
docs/talks/**/*.log
docs/talks/**/*.out
